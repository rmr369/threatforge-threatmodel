                  "network",
                  "pack:k8s-network",
                  "security",
                  "stride/D",
                  "stride/S"
                ],
                "security-severity": "6.4",
                "precision": "high"
              }
            },
            {
              "id": "TF-CLOUD-001",
              "name": "ObjectStorageBucketHasAPublicAcl",
              "shortDescription": {
                "text": "Object storage bucket has a public ACL"
              },
              "fullDescription": {
                "text": "aws_s3_bucket assets is configured with a public-read or public-read-write ACL. Public buckets are found by automated scanners within hours. public-read-write is worse than disclosure: anyone can also overwrite objects, which turns the bucket into a malware distribution point under your domain."
              },
              "help": {
                "text": "aws_s3_bucket assets is configured with a public-read or public-read-write ACL. Public buckets are found by automated scanners within hours. public-read-write is worse than disclosure: anyone can also overwrite objects, which turns the bucket into a malware distribution point under your domain. **Remediation:** Set the ACL to private and enable the account-level public access block. ```yaml resource \"aws_s3_bucket_public_access_block\" \"this\" { bucket = aws_s3_bucket.this.id block_public_acls = true block_public_policy = true ignore_public_acls = true restrict_public_buckets = true } ``` CWE: CWE-732, CWE-284 \u00b7 MITRE: T1530 \u00b7 NIST: AC-3, SC-28",
                "markdown": "aws_s3_bucket assets is configured with a public-read or public-read-write ACL. Public buckets are found by automated scanners within hours. public-read-write is worse than disclosure: anyone can also overwrite objects, which turns the bucket into a malware distribution point under your domain.\n\n**Remediation:** Set the ACL to private and enable the account-level public access block.\n\n```yaml\nresource \"aws_s3_bucket_public_access_block\" \"this\" {\n  bucket                  = aws_s3_bucket.this.id\n  block_public_acls       = true\n  block_public_policy     = true\n  ignore_public_acls      = true\n  restrict_public_buckets = true\n}\n```\n\nCWE: CWE-732, CWE-284 \u00b7 MITRE: T1530 \u00b7 NIST: AC-3, SC-28"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "cloud",
                  "critical-path",
                  "cwe/CWE-284",
                  "cwe/CWE-732",
                  "data-exposure",
                  "mitre/T1530",
                  "pack:cloud-terraform",
                  "security",
                  "stride/I"
                ],
                "security-severity": "6.0",
                "precision": "very-high"
              }
            },
            {
              "id": "TF-CLOUD-002",
              "name": "DatabaseInstanceIsPubliclyAccessible",
              "shortDescription": {
                "text": "Database instance is publicly accessible"
              },
              "fullDescription": {
                "text": "aws_db_instance shop is assigned a public endpoint. Managed database endpoints are continuously scanned and brute-forced; combined with a weak or reused master password this is a direct route to the full dataset."
              },
              "help": {
                "text": "aws_db_instance shop is assigned a public endpoint. Managed database endpoints are continuously scanned and brute-forced; combined with a weak or reused master password this is a direct route to the full dataset. **Remediation:** Place the instance in private subnets and reach it through a bastion or VPN. ```yaml publicly_accessible = false # and ensure db_subnet_group_name points at private subnets only ``` CWE: CWE-284, CWE-668 \u00b7 MITRE: T1190, T1133 \u00b7 NIST: SC-7, AC-3",
                "markdown": "aws_db_instance shop is assigned a public endpoint. Managed database endpoints are continuously scanned and brute-forced; combined with a weak or reused master password this is a direct route to the full dataset.\n\n**Remediation:** Place the instance in private subnets and reach it through a bastion or VPN.\n\n```yaml\npublicly_accessible = false\n# and ensure db_subnet_group_name points at private subnets only\n```\n\nCWE: CWE-284, CWE-668 \u00b7 MITRE: T1190, T1133 \u00b7 NIST: SC-7, AC-3"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
