            {
              "id": "TF-CLOUD-010",
              "name": "DatabaseDeletionProtectionAndFinalSnapshotAreBothDisabled",
              "shortDescription": {
                "text": "Database deletion protection and final snapshot are both disabled"
              },
              "fullDescription": {
                "text": "aws_db_instance shop can be destroyed with no snapshot retained. A compromised CI credential, or a plain mistake in a `terraform apply`, results in unrecoverable data loss -- this is the destructive end of the availability spectrum."
              },
              "help": {
                "text": "aws_db_instance shop can be destroyed with no snapshot retained. A compromised CI credential, or a plain mistake in a `terraform apply`, results in unrecoverable data loss -- this is the destructive end of the availability spectrum. **Remediation:** Enable deletion protection and keep final snapshots. ```yaml deletion_protection = true skip_final_snapshot = false ``` CWE: CWE-1188 \u00b7 MITRE: T1485 \u00b7 NIST: CP-9, CP-10",
                "markdown": "aws_db_instance shop can be destroyed with no snapshot retained. A compromised CI credential, or a plain mistake in a `terraform apply`, results in unrecoverable data loss -- this is the destructive end of the availability spectrum.\n\n**Remediation:** Enable deletion protection and keep final snapshots.\n\n```yaml\ndeletion_protection = true\nskip_final_snapshot = false\n```\n\nCWE: CWE-1188 \u00b7 MITRE: T1485 \u00b7 NIST: CP-9, CP-10"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "availability",
                  "cloud",
                  "cwe/CWE-1188",
                  "mitre/T1485",
                  "pack:cloud-terraform",
                  "security",
                  "stride/D"
                ],
                "security-severity": "1.2",
                "precision": "very-high"
              }
