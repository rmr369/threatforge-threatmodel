        <b:Title>Container can escalate privileges</b:Title>
        <b:TypeId>TF-K8S-002</b:TypeId>
        <b:Upgraded>false</b:Upgraded>
      </a:Value>
    </a:KeyValueOfstringThreatpc_P0_PhOB>
    <a:KeyValueOfstringThreatpc_P0_PhOB>
