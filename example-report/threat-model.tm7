        <b:DrawingSurfaceGuid>53412b27-c301-5c73-9dcd-cecf78da5cd3</b:DrawingSurfaceGuid>
        <b:FlowGuid>d0cc2c89-81b2-509c-ac4f-e58de98e6d12</b:FlowGuid>
        <b:Id>44</b:Id>
        <b:InteractionKey>b5009d2d-68ab-53d1-bcd7-6bbaad1b988b:d0cc2c89-81b2-509c-ac4f-e58de98e6d12:57afd2db-637e-5bd3-b401-ea6d296b4a7e</b:InteractionKey>
