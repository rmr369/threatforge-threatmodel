        <b:TargetGuid>e69287b9-e00f-58ba-8346-1e34b50791d2</b:TargetGuid>
        <b:Title>Compose service publishes a port on all interfaces</b:Title>
        <b:TypeId>TF-CMP-003</b:TypeId>
        <b:Upgraded>false</b:Upgraded>
      </a:Value>
