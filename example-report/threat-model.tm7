        <b:Properties>
          <a:KeyValueOfstringstring>
            <a:Key>Title</a:Key>
            <a:Value>Base image uses a mutable tag</a:Value>
          </a:KeyValueOfstringstring>
          <a:KeyValueOfstringstring>
