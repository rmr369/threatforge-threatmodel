        <b:TargetGuid>61d1449b-9cf2-5df9-8a35-6ae635b61aa3</b:TargetGuid>
        <b:Title>ClusterRole grants full cluster administration</b:Title>
        <b:TypeId>TF-RBAC-001</b:TypeId>
        <b:Upgraded>false</b:Upgraded>
      </a:Value>
