  rule_id: TF-CMP-005
  mitigation:
    status: open
    description: Set deploy.resources.limits.
    effort: low
- id: TF-6B50967983
  title: Namespace has no ResourceQuota
  category: Denial of Service
  element: k8s:Namespace:default/shop
  severity: low
  description: Namespace shop has no ResourceQuota, so a single runaway or malicious workload here can
    consume the cluster's entire allocatable capacity and starve every other tenant.
