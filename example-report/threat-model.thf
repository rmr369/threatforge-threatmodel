    mitre:
    - T1584.001
    nist:
    - SC-7
  rule_id: TF-NET-006
  mitigation:
    status: open
    description: List explicit hostnames.
    effort: low
- id: TF-462B615D86
  title: Role can write Secrets
  category: Tampering
  element: k8s:ClusterRole:default/shop-operator
  severity: high
  description: Write access to Secrets allows an attacker to plant credentials that other workloads will
    trust -- for example replacing a TLS keypair or an image pull secret to redirect pulls to an attacker-controlled
    registry.
  evidence:
  - description: 'write verbs on secrets: *'
    observed:
    - '*'
    location: k8s/app.yaml:156
  risk:
    score: 12
    likelihood: 3
    impact: 4
    exposure_hops: 4
  references:
