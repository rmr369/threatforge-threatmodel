data_flows:
- id: flow-1
  flow_number: 1
  name: Card authorisation
  from: k8s:Deployment:shop/storefront
  to: manual:payment-provider
  protocol: HTTPS/TLS-1.3
  encrypted: true
  authenticated: true
  data:
  - pci
  crosses_trust_boundary: true
- id: flow-2
  flow_number: 2
  name: Nightly customer sync
  from: k8s:StatefulSet:shop/postgres
  to: manual:crm-saas
  protocol: http
  encrypted: false
  authenticated: false
  data:
  - pii
  crosses_trust_boundary: true
- id: flow-3
  flow_number: 3
  name: kubectl exec
  from: manual:ops-engineer
  to: k8s:Deployment:shop/storefront
  protocol: https
  encrypted: true
  authenticated: true
  crosses_trust_boundary: true
- id: flow-4
  flow_number: 4
  name: Checkout request
  from: tmt:22222222-0000-0000-0000-000000000001
  to: tmt:22222222-0000-0000-0000-000000000002
  protocol: https
  encrypted: true
  crosses_trust_boundary: true
- id: flow-5
  flow_number: 5
  name: Billing query
