    - K05
  rule_id: TF-NET-002
  mitigation:
    status: open
    description: Default-deny egress; allow DNS plus the specific destinations required.
    effort: medium
- id: TF-7940C9851E
  title: Service account token automounted on the default service account
  category: Elevation of Privilege
  element: k8s:ServiceAccount:shop/default
  severity: medium
  description: The `default` ServiceAccount in namespace shop automounts its token into every pod that
    does not specify another SA. This is the most commonly abused foothold for lateral movement inside
    a namespace.
  evidence:
  - description: automountServiceAccountToken is not false
    observed: null
    location: <implicit>
  risk:
    score: 9
    likelihood: 3
    impact: 3
    exposure_hops: 3
  references:
