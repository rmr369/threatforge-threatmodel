  to: tmt:22222222-0000-0000-0000-000000000003
  protocol: sql
  data:
  - pii
- id: flow-6
  flow_number: 6
  name: checkout (https)
  from: drawio:cust
  to: drawio:api
  protocol: https
  encrypted: true
  crosses_trust_boundary: true
- id: flow-7
  flow_number: 7
  name: post ledger entry (http)
  from: drawio:api
  to: drawio:ledger
  protocol: http
  encrypted: false
- id: flow-8
  flow_number: 8
  name: read card token (sql)
  from: drawio:ledger
  to: drawio:db
  protocol: sql
  data:
  - pii
- id: flow-9
  flow_number: 9
  name: routes to
  from: k8s:Service:shop/storefront
  to: k8s:Deployment:shop/storefront
  protocol: tcp:80
  encrypted: false
  crosses_trust_boundary: true
- id: flow-10
  flow_number: 10
  name: routes to
  from: k8s:Service:shop/postgres
  to: k8s:StatefulSet:shop/postgres
  protocol: tcp:5432
  encrypted: false
  data:
  - pii
- id: flow-11
  flow_number: 11
  name: routes to
  from: k8s:Ingress:shop/storefront-ingress
  to: k8s:Service:shop/storefront
  protocol: http:80
  encrypted: false
- id: flow-12
  flow_number: 12
  name: mounts
  from: k8s:Deployment:shop/storefront
  to: k8s:HostPath:shop//var/run/docker.sock
  crosses_trust_boundary: true
- id: flow-13
  flow_number: 13
  name: mounts
  from: k8s:StatefulSet:shop/postgres
  to: k8s:PersistentVolumeClaim:shop/postgres-pvc
  data:
  - pii
- id: flow-14
  flow_number: 14
  name: reads
  from: k8s:Container:shop/postgres/postgres
  to: k8s:Secret:shop/shop-db
  data:
  - credential
  - pii
  - secret
- id: flow-15
  flow_number: 15
  name: assumes
  from: k8s:Deployment:shop/storefront
  to: k8s:ServiceAccount:shop/default
  crosses_trust_boundary: true
- id: flow-16
  flow_number: 16
  name: assumes
  from: k8s:StatefulSet:shop/postgres
  to: k8s:ServiceAccount:shop/postgres-sa
- id: flow-17
  flow_number: 17
  name: granted
  from: k8s:ServiceAccount:shop/postgres-sa
  to: k8s:ClusterRole:default/shop-operator
  crosses_trust_boundary: true
- id: flow-18
  flow_number: 18
  name: external access
  from: ext:internet
  to: k8s:Ingress:shop/storefront-ingress
  protocol: http
  encrypted: false
  crosses_trust_boundary: true
- id: flow-19
  flow_number: 19
  name: external access
  from: ext:internet
  to: k8s:Service:shop/storefront
  protocol: tcp:80
  encrypted: false
  crosses_trust_boundary: true
- id: flow-20
  flow_number: 20
  name: external access
  from: ext:internet
  to: k8s:Service:shop/postgres
  protocol: tcp:5432
  crosses_trust_boundary: true
- id: flow-21
  flow_number: 21
  name: external access
  from: ext:internet
  to: compose:service:api
trust_boundaries:
- id: boundary:internet
  name: Internet
  description: Anonymous, unauthenticated, fully untrusted network.
  trust_level: 0
  contains:
  - drawio:cust
  - ext:internal-user
  - ext:internet
  - manual:ops-engineer
  - manual:payment-provider
  - tmt:22222222-0000-0000-0000-000000000001
- id: boundary:tmt:33333333-0000-0000-0000-000000000001
  name: Corporate DMZ
  description: Trust boundary imported from a Microsoft TMT model (Corporate DMZ).
  trust_level: 30
  contains:
  - tmt:22222222-0000-0000-0000-000000000002
  - tmt:22222222-0000-0000-0000-000000000003
- id: boundary:drawio:dmz
  name: Corporate DMZ
  description: Trust boundary from architecture.drawio (Payments architecture).
  trust_level: 30
  contains:
  - drawio:api
  - drawio:db
  - drawio:ledger
- id: boundary:manual:third-party
  name: Third-party processors
  description: Outside our control. Contractual controls only; no technical enforcement.
  trust_level: 40
  contains:
  - manual:crm-saas
  - manual:payment-provider
- id: boundary:cloud:aws
  name: AWS account
  description: Managed aws resources. Trust is enforced by IAM, not by network position.
  trust_level: 40
  contains:
  - tf:aws_db_instance.shop
  - tf:aws_iam_policy.broad
  - tf:aws_instance.worker
  - tf:aws_s3_bucket.assets
  - tf:aws_security_group.web
- id: boundary:cluster:default
  name: Kubernetes cluster
  description: Everything inside the cluster network and API server.
  trust_level: 60
  contains:
  - k8s:ClusterRole:default/shop-operator
  - k8s:ClusterRoleBinding:default/shop-operator-binding
  - k8s:ConfigMap:shop/shop-config
  - k8s:Container:shop/postgres/postgres
  - k8s:Container:shop/storefront/sidecar-agent
  - k8s:Container:shop/storefront/web
  - k8s:Deployment:shop/storefront
  - k8s:HostPath:shop//var/run/docker.sock
  - k8s:Ingress:shop/storefront-ingress
  - k8s:Namespace:default/shop
  - k8s:PersistentVolumeClaim:shop/postgres-pvc
  - k8s:Secret:shop/shop-db
  - k8s:Service:shop/postgres
  - k8s:Service:shop/storefront
  - k8s:ServiceAccount:shop/default
  - k8s:ServiceAccount:shop/postgres-sa
  - k8s:StatefulSet:shop/postgres
- id: boundary:namespace:shop
  name: namespace/shop
  description: Application namespace.
  trust_level: 70
  contains:
  - k8s:ConfigMap:shop/shop-config
  - k8s:Container:shop/postgres/postgres
  - k8s:Container:shop/storefront/sidecar-agent
  - k8s:Container:shop/storefront/web
  - k8s:Deployment:shop/storefront
  - k8s:HostPath:shop//var/run/docker.sock
  - k8s:Ingress:shop/storefront-ingress
  - k8s:PersistentVolumeClaim:shop/postgres-pvc
  - k8s:Secret:shop/shop-db
  - k8s:Service:shop/postgres
  - k8s:Service:shop/storefront
  - k8s:ServiceAccount:shop/default
  - k8s:ServiceAccount:shop/postgres-sa
  - k8s:StatefulSet:shop/postgres
- id: boundary:node
  name: Worker node (host OS)
  description: Node filesystem, kubelet, and container runtime. Reaching here means the container boundary
    has been bypassed.
  trust_level: 95
  contains:
  - k8s:Deployment:shop/storefront
threats:
- id: TF-819BDDAC5F
  title: Compose service runs privileged
  category: Elevation of Privilege
  element: compose:service:api
  severity: critical
  description: 'ComposeService api runs with `privileged: true`, disabling container isolation entirely.
    Code execution in this service is equivalent to root on the host.'
  evidence:
  - description: 'privileged: true'
    observed: true
    location: docker-compose.yml:2
  risk:
    score: 25
    likelihood: 5
    impact: 5
    exposure_hops: 1
  references:
    cwe:
    - CWE-250
    mitre:
    - T1611
    nist:
    - AC-6
  rule_id: TF-CMP-001
  mitigation:
    status: open
    description: Remove privileged; grant specific cap_add entries instead.
    effort: medium
- id: TF-FEFA5E2ECC
  title: Compose service mounts the Docker socket
  category: Elevation of Privilege
  element: compose:service:api
  severity: critical
  description: ComposeService api mounts /var/run/docker.sock. This grants full control of the Docker
    daemon, which is root on the host by another name.
  evidence:
  - description: docker.sock is mounted
    observed: true
    location: docker-compose.yml:2
  risk:
    score: 25
    likelihood: 5
    impact: 5
    exposure_hops: 1
  references:
    cwe:
    - CWE-250
    - CWE-284
    mitre:
    - T1610
    nist:
    - AC-6
  rule_id: TF-CMP-002
  mitigation:
    status: open
    description: Use a socket proxy with a minimal API allowlist, or rootless Docker.
    effort: high
- id: TF-4C0792136E
  title: Compose service has plaintext credentials in environment
  category: Information Disclosure
  element: compose:service:api
  severity: critical
  description: Credential-shaped environment variables are set inline in the compose file, which is version-controlled
    and visible to anyone who can run `docker inspect`.
  evidence:
  - description: credential-like env vars with literal values
    observed: true
    location: docker-compose.yml:2
