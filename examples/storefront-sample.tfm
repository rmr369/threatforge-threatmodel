 "document": {
  "fields": {
   "title": "Storefront reference architecture",
   "owner": "Platform Security",
   "reviewer": "R Rajamohan Reddy",
   "stakeholders": "Payments\nStorefront engineering\nPlatform SRE",
   "scope": "Customer-facing storefront, order capture, and card payment hand-off to the payment provider.",
   "out_of_scope": "Warehouse and fulfilment systems; the corporate network; anything behind the payment provider's own boundary.",
   "assumptions": "TLS terminates at the CDN and is re-established to the origin\nCard numbers never touch our servers; only the provider token does\nThe operator VPN is the only route to the admin console",
   "dependencies": "Payment provider (card authorisation)\nManaged Postgres and object storage",
   "data_classification": "PII and PCI tokens",
   "compliance": "PCI-DSS SAQ-A EP, UK GDPR"
  },
  "answers": {
   "authn": "OIDC at the gateway; the identity provider issues short-lived tokens. Service-to-service uses mTLS inside the application tier.",
   "transit": "TLS on every hop except Orders API to the session cache, which is plaintext on the internal network. Known, not accepted.",
   "rest": "Postgres and the receipt archive are encrypted with managed keys. The session cache is not.",
   "input": "Validated at the gateway and in the storefront. The Orders API does not validate what it receives."
  }
 },
