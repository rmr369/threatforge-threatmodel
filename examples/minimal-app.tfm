 "overlay": "# A minimal application: customer, web app, API, and two stores.\nmetadata:\n  title: Minimal web application\ncomponents:\n  - id: \"user\"\n    type: external_entity\n    name: \"Customer\"\n    trust_zone: external\n    component_type: \"browser\"\n    attributes:\n      \"authenticates_itself\": false\n      \"entity_type\": \"human\"\n      \"controlled_by_us\": false\n  - id: \"web\"\n    type: process\n    name: \"Web application\"\n    trust_zone: dmz\n    component_type: \"web_server\"\n    attributes:\n      \"accepts_input_from\": \"any_remote\"\n      \"sanitizes_input\": true\n      \"implements_authn\": true\n      \"implements_authz\": true\n      \"running_as\": \"least_privilege\"\n      \"logs_security_events\": true\n      \"isolation_level\": \"container\"\n      \"code_type\": \"managed\"\n      \"sanitizes_output\": true\n      \"handles_secrets\": false\n  - id: \"api\"\n    type: process\n    name: \"Orders API\"\n    trust_zone: internal\n    component_type: \"microservice\"\n    data: [\"pii\"]\n    attributes:\n      \"accepts_input_from\": \"any_remote\"\n      \"sanitizes_input\": false\n      \"implements_authn\": true\n      \"implements_authz\": true\n      \"running_as\": \"service_account\"\n      \"logs_security_events\": true\n      \"isolation_level\": \"container\"\n      \"code_type\": \"managed\"\n      \"sanitizes_output\": true\n      \"handles_secrets\": true\n  - id: \"db\"\n    type: data_store\n    name: \"Orders database\"\n    trust_zone: restricted\n    component_type: \"sql_db\"\n    data: [\"pii\"]\n    attributes:\n      \"store_type\": \"sql\"\n      \"encrypted\": true\n      \"backup\": true\n      \"signed\": false\n      \"stores_credentials\": false\n      \"write_access\": true\n      \"shared\": false\n      \"removable_storage\": false\n      \"stores_log_data\": false\n  - id: \"cache\"\n    type: data_store\n    name: \"Session store\"\n    trust_zone: internal\n    component_type: \"cache\"